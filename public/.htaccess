# Never cache the HTML shell, so a new deploy is picked up immediately
# instead of being served stale from disk/WebKit caches (this is what
# caused iOS home-screen "app" icons to keep showing an old version).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # The service worker script (and its Workbox helper) must always be
  # revalidated too, otherwise the browser would never notice a new
  # version was deployed - same failure mode as a cached index.html.
  <FilesMatch "^(sw|workbox-.*)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Hashed build assets (in /assets/) never change once built - a new
  # build gets new filenames anyway - so these can be cached forever.
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
